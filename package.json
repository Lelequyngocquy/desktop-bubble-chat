{
  "name": "desktop-bubble-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:start": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "app:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "app:build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "app:check": "powershell -ExecutionPolicy Bypass -File scripts/check_env.ps1",
    "appium:start": "powershell -ExecutionPolicy Bypass -File scripts/appium-server.ps1 -Action start",
    "appium:stop": "powershell -ExecutionPolicy Bypass -File scripts/appium-server.ps1 -Action stop",
    "appium:status": "powershell -ExecutionPolicy Bypass -File scripts/appium-server.ps1 -Action status",
    "appium:check": "node tests/e2e/run-appium-check.js",
    "test:e2e": "node tests/e2e/run-appium-check.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "webdriverio": "^10.1.0"
  }
}
