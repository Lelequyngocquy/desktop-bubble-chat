{
  "name": "desktop-bubble-chat",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:start": "node -e \"const p=process.platform;const s=p==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/windows/start.ps1':p==='darwin'?'bash scripts/macos/start.sh':'bash scripts/linux/start.sh';require('child_process').spawn(s,{stdio:'inherit',shell:true})\"",
    "app:stop": "node -e \"const p=process.platform;const s=p==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/windows/stop.ps1':p==='darwin'?'bash scripts/macos/stop.sh':'bash scripts/linux/stop.sh';require('child_process').spawn(s,{stdio:'inherit',shell:true})\"",
    "app:build": "node -e \"const p=process.platform;const s=p==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/windows/build.ps1':p==='darwin'?'bash scripts/macos/build.sh':'bash scripts/linux/build.sh';require('child_process').spawn(s,{stdio:'inherit',shell:true})\"",
    "app:check": "node -e \"const p=process.platform;const s=p==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/windows/check_env.ps1':p==='darwin'?'bash scripts/macos/check_env.sh':'bash scripts/linux/check_env.sh';require('child_process').spawn(s,{stdio:'inherit',shell:true})\"",
    "app:perf": "node -e \"const p=process.platform;const s=p==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/windows/status.ps1':p==='darwin'?'bash scripts/macos/status.sh':'bash scripts/linux/status.sh';require('child_process').spawn(s,{stdio:'inherit',shell:true})\"",
    "app:start:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "app:start:linux": "bash scripts/linux/start.sh",
    "app:start:mac": "bash scripts/macos/start.sh",
    "app:perf:win": "powershell -ExecutionPolicy Bypass -File scripts/windows/status.ps1",
    "app:perf:linux": "bash scripts/linux/status.sh",
    "app:perf:mac": "bash scripts/macos/status.sh",
    "test:e2e": "node tests/e2e/run-appium-check.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.12",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "webdriverio": "^10.1.0"
  }
}
