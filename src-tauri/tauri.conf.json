{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopBubbleChat",
  "version": "1.0.3",
  "identifier": "com.desktopbubblechat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DesktopBubbleChat - Bong Bóng Trò Chuyện",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=Translate,OptimizationHints,MediaRouter,DialMediaRouteProvider,CalculateNativeWinOcclusion,InterestFeedContentSuggestions,AutofillServerCommunication,CertificateTransparencyComponentUpdater,msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-extensions --disable-component-extensions-with-background-pages --disable-sync --disable-default-apps --disable-spell-checking --renderer-process-limit=1 --process-per-site --disable-3d-apis --disable-usb-keyboard-detect --disable-gamepad --disable-speech-api --autoplay-policy=no-user-gesture-required --disk-cache-size=52428800 --media-cache-size=20971520"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "shortDescription": "Floating Bubble Chat for Messenger with Auto-Trim RAM",
    "longDescription": "DesktopBubbleChat brings mobile-style floating chat heads to desktop with multi-account support, 4-tier auto-trim RAM optimization, and zero-click hover interactions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": null
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl3 | libssl1.1"
        ],
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQ0E3NzQ1MzRGQTkzMjcKUldRbmsvbzBSWGZLdW5DK0N6KzZCdXNCSUZzd05tRTJzSWczNTdCejBQUk4xOFVnK2dRR1U2Uy8K",
      "endpoints": [
        "https://github.com/Lelequyngocquy/desktop-bubble-chat/releases/latest/download/latest.json"
      ]
    }
  }
}
