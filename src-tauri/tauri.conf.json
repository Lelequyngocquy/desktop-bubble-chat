{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopBubbleChat",
  "version": "0.1.0",
  "identifier": "com.desktopbubblechat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DesktopBubbleChat",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      },
      {
        "label": "bubble",
        "title": "DesktopBubbleChat - Bubble",
        "url": "index.html?window=bubble",
        "width": 64,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "chat-messenger",
        "title": "Messenger",
        "url": "https://www.messenger.com/",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
